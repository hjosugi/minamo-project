{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hjosugi.github.io/minamo-project/docs/product/drum-dataset.schema.json",
  "title": "Minamo drum dataset annotation",
  "description": "Per-frame stick/drum labels for training a YOLO-family detector (issue #122).",
  "type": "object",
  "required": ["schema", "frameId", "labels", "consent"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "minamo.drum-dataset.v1" },
    "frameId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "labels": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/stickLabel" },
          { "$ref": "#/definitions/drumZoneLabel" },
          { "$ref": "#/definitions/hitLabel" }
        ]
      }
    },
    "consent": { "$ref": "#/definitions/consent" }
  },
  "definitions": {
    "point": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "z": { "type": "number" }
      }
    },
    "hand": {
      "enum": ["Left", "Right"]
    },
    "zoneType": {
      "enum": [
        "snare",
        "hihat",
        "ride",
        "crash",
        "tom",
        "floorTom",
        "kick",
        "bass",
        "slap",
        "tap",
        "head",
        "edge",
        "percussion"
      ]
    },
    "stickLabel": {
      "type": "object",
      "required": ["kind", "id", "points", "hand", "representation"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "stick" },
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/definitions/point" }
        },
        "hand": { "$ref": "#/definitions/hand" },
        "representation": {
          "description": "keypoint-only uses one tip and has no YOLO box; tip-tail-padded uses two points and derives a box by adding 0.01 normalized-frame padding on every side, clamped to [0,1].",
          "enum": ["keypoint-only", "tip-tail-padded"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "representation": { "const": "keypoint-only" } } },
          "then": { "properties": { "points": { "type": "array", "minItems": 1, "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "representation": { "const": "tip-tail-padded" } } },
          "then": { "properties": { "points": { "type": "array", "minItems": 2, "maxItems": 2 } } }
        }
      ]
    },
    "drumZoneLabel": {
      "type": "object",
      "required": ["kind", "id", "points", "zoneType"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "drumZone" },
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/definitions/point" }
        },
        "zoneType": { "$ref": "#/definitions/zoneType" }
      }
    },
    "hitLabel": {
      "type": "object",
      "required": ["kind", "id", "points", "zoneType", "timeMs"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "hit" },
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/definitions/point" }
        },
        "zoneType": { "$ref": "#/definitions/zoneType" },
        "hand": { "$ref": "#/definitions/hand" },
        "timeMs": { "type": "number", "minimum": 0 }
      }
    },
    "consent": {
      "type": "object",
      "required": ["localOnly", "license"],
      "additionalProperties": false,
      "properties": {
        "localOnly": { "type": "boolean" },
        "license": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}

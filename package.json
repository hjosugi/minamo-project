{
  "name": "minamo",
  "version": "0.1.17",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && node scripts/copy-pages-static.mjs",
    "lint": "node scripts/lint.mjs",
    "preview": "vite preview",
    "test": "node tests/run-tests.mjs && node scripts/check-tree-duplication.mjs && node scripts/check-privacy-invariants.mjs && vitest run",
    "verify": "python3 scripts/verify_structure.py",
    "release:smoke": "node scripts/release-smoke.mjs",
    "typecheck:js": "tsc --noEmit -p tsconfig.browser-js.json",
    "inspect:glb": "node scripts/inspect-glb.mjs",
    "pack:avatar": "node scripts/kagami-pack.mjs",
    "benchmark:drum": "tsx scripts/drum-benchmark.ts",
    "benchmark:drum:ci": "tsx scripts/drum-benchmark.ts tests/fixtures/drum-benchmark-runner.manifest.json",
    "benchmark:pipeline": "node scripts/benchmark-motion-pipeline.mjs",
    "bench:allocs": "node --expose-gc --import tsx scripts/bench-frame-allocs.ts",
    "coverage": "c8 node tests/run-tests.mjs && node scripts/check-coverage.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@pixiv/three-vrm": "^3.5.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "ag-psd": "^31.0.2",
    "qrcode": "1.5.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "c8": "^12.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  }
}
